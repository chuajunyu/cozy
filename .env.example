OPENAI_API_KEY=

# Astra cost controls. Restart the backend after changing these.
# Use low for cheaper routine work; medium preserves the existing design setting.
COZY_ASTRA_REASONING_EFFORT=medium
COZY_ASTRA_MAX_OUTPUT_TOKENS=7000
COZY_ASTRA_MAX_RESPONSES=40
# Stop continuing a run after this many reported output tokens (includes reasoning).
# This is not a hard dollar cap; in-flight work and missing usage can exceed it.
COZY_ASTRA_MAX_RUN_OUTPUT_TOKENS=28000
# Optional path override; default is logs/astra-usage.jsonl at the repository root.
# COZY_ASTRA_USAGE_LOG=
